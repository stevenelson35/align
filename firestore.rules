rules_version = '2';

// See DESIGN.md §11. Household roles live in household/main and change only via the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Roles ----

    function signedIn() {
      return request.auth != null;
    }

    function roleOf(uid) {
      return get(/databases/$(database)/documents/household/main).data.members.get(uid, {}).get('role', '');
    }

    function isMember() {
      return signedIn() && roleOf(request.auth.uid) == 'member';
    }

    function isViewer() {
      return signedIn() && roleOf(request.auth.uid) == 'viewer';
    }

    // ---- Lists and tasks share visibility (tasks carry a copy of their list's fields) ----

    // Shared docs list their people in sharedWith (only shared docs have that field; see sharedOk), so
    // "shared with me" is the single query where('sharedWith', 'array-contains', uid), which this rule can prove.
    function canRead(d) {
      return (d.visibility == 'private' && isMember() && d.ownerId == request.auth.uid)
        || (d.visibility == 'family' && (isMember() || (isViewer() && d.viewerVisible == true)))
        || ((isMember() || isViewer()) && request.auth.uid in d.get('sharedWith', []));
    }

    // Visibility 'shared' if and only if there's a sharedWith list of 1-50 people that includes the owner (50 leaves
    // room for an extended family of view-only accounts, e.g. on a gift list).
    function sharedOk(d) {
      return (d.visibility == 'shared') == ('sharedWith' in d)
        && (!('sharedWith' in d) || (d.sharedWith is list && d.sharedWith.size() >= 1 && d.sharedWith.size() <= 50
                                     && d.ownerId in d.sharedWith));
    }

    // Who can change a list or task: its owner; or, by "who can edit" (editAudience, copied onto tasks): every
    // member for Family / Everyone, the people in `editors` for Parents / Chosen people, only the owner for Only me.
    // Without editAudience (lists made before it existed), anyone who can see it may change it, as before. Either
    // way they must be able to see it.
    function canWrite(d) {
      return isMember() && canRead(d) && (d.ownerId == request.auth.uid
        || (!('editAudience' in d) && (d.visibility == 'family' || request.auth.uid in d.get('sharedWith', [])))
        || d.get('editAudience', '') in ['family', 'everyone']
        || request.auth.uid in d.get('editors', []));
    }

    function validEditFields(d) {
      return (!('editAudience' in d) || d.editAudience in ['private', 'parents', 'family', 'shared', 'everyone'])
        && (!('editors' in d) || (d.editors is list && d.editors.size() <= 20));
    }

    // ---- Household ----

    function ownMemberEntryOnly() {
      let before = resource.data.members;
      let after = request.resource.data.members;
      let uid = request.auth.uid;
      return after.diff(before).affectedKeys().hasOnly([uid])
        && after[uid].role == before[uid].role
        && after[uid].keys().hasOnly(['role', 'displayName', 'color', 'defaultVisibility', 'phone', 'pinnedLinks', 'newTaskDue'])
        // Whether tasks added without a date are due the day they're added (Settings).
        && (!('newTaskDue' in after[uid]) || after[uid].newTaskDue in ['today', 'none'])
        // Their own default for new lists and quick adds, and their mobile number for "text …" (Settings).
        && (!('defaultVisibility' in after[uid]) || after[uid].defaultVisibility in ['private', 'parents', 'family', 'everyone'])
        && (!('phone' in after[uid]) || (after[uid].phone is string && after[uid].phone.size() <= 24))
        // Links they pinned to their own Align menu (ids of links-list items).
        && (!('pinnedLinks' in after[uid]) || (after[uid].pinnedLinks is list && after[uid].pinnedLinks.size() <= 30));
    }

    // Once someone is in the Parents group, only a parent can change who's in it (so a child can't opt in).
    // While it's empty, any member can set it up.
    function parentsChangeOk() {
      let before = resource.data.get('groups', {}).get('parents', []);
      let after = request.resource.data.get('groups', {}).get('parents', []);
      return after == before || before.size() == 0 || request.auth.uid in before;
    }

    function householdExists() {
      return exists(/databases/$(database)/documents/household/main);
    }

    // First-time setup: before household/main exists, a signed-in user may create it with themselves as a member.
    function validNewHousehold() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'members', 'pets', 'weeklyTokens', 'tokenStartDate'])
        && d.name is string && d.name.size() > 0
        && d.members[request.auth.uid].role == 'member'
        && d.pets is list
        && d.weeklyTokens is int && d.weeklyTokens >= 0
        && d.tokenStartDate is timestamp;
    }

    match /household/main {
      allow read: if isMember() || isViewer();
      // Lets the app tell "not set up yet" apart from "not in this household".
      allow get: if signedIn() && !householdExists();
      allow create: if signedIn() && validNewHousehold();
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pets', 'weeklyTokens', 'members', 'groups'])
        && ownMemberEntryOnly()
        // groups: { parents: [uid, ...] } for the "Parents" sharing shortcut. Only a convenience: who can read a
        // shared list is always its own sharedWith list, shown by name when you share.
        && (!('groups' in request.resource.data) || request.resource.data.groups is map)
        && parentsChangeOk();
    }

    // ---- Lists ----

    function validList(d) {
      return d.name is string && d.name.size() > 0
        && d.kind in ['list', 'project', 'checklist', 'notes', 'links', 'picks', 'cards', 'contacts', 'gifts']
        // Gift lists: for a member (recipientId) or anyone by name. A secret companion (surprise ideas) must be
        // shared with chosen people that don't include the recipient, so the rules keep it from them.
        && (!('recipientId' in d) || (d.kind == 'gifts' && d.recipientId is string))
        && (!('recipientName' in d) || (d.kind == 'gifts' && d.recipientName is string && d.recipientName.size() <= 100))
        && (!('giftSecret' in d) || (d.giftSecret == true && d.kind == 'gifts' && d.visibility == 'shared'
                                     && 'recipientId' in d && !(d.recipientId in d.sharedWith)))
        && (!('secretOf' in d) || (d.get('giftSecret', false) == true && d.secretOf is string))
        && (!('pickKind' in d) || d.pickKind in ['shows', 'movies', 'theater', 'music', 'books', 'games', 'other'])
        && d.visibility in ['private', 'family', 'shared']
        && sharedOk(d)
        && d.viewerVisible is bool
        && (d.visibility == 'family' || d.viewerVisible == false)
        && d.defaultContext in ['family', 'work']
        && validEditFields(d)
        && d.ownerId is string;
    }

    match /lists/{listId} {
      allow read: if canRead(resource.data);
      allow create: if canWrite(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && validList(request.resource.data);
      // Only the current owner may hand a list to someone else, or change who can edit it.
      allow update: if canWrite(resource.data)
        && (canWrite(request.resource.data) || resource.data.ownerId == request.auth.uid)
        && (request.resource.data.ownerId == resource.data.ownerId || resource.data.ownerId == request.auth.uid)
        && ((request.resource.data.get('editAudience', null) == resource.data.get('editAudience', null)
             && request.resource.data.get('editors', null) == resource.data.get('editors', null))
            || resource.data.ownerId == request.auth.uid)
        && validList(request.resource.data);
      allow delete: if canWrite(resource.data);
      // Gift lists: view-only accounts (extended family) may make the hidden companion for secret ideas when there
      // isn't one yet: for a real gift list, with its recipient, and (validList) never shared with the recipient.
      allow create: if isViewer()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.get('giftSecret', false) == true
        && validList(request.resource.data)
        && get(/databases/$(database)/documents/lists/$(request.resource.data.secretOf)).data.kind == 'gifts'
        && get(/databases/$(database)/documents/lists/$(request.resource.data.secretOf)).data.get('recipientId', '') == request.resource.data.recipientId
        && request.auth.uid in request.resource.data.sharedWith;
    }

    // ---- Goals (daily: check, tally, progressive, measure) ----
    // Same privacy as lists (private / family / shared). The day-by-day log lives on the goal doc.

    function validGoal(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.kind in ['check', 'tally', 'progressive', 'measure', 'total']
        && (!('editAudience' in d) || d.editAudience in ['private', 'parents', 'family', 'shared', 'everyone'])
        && (!('editors' in d) || (d.editors is list && d.editors.size() <= 20))
        && d.visibility in ['private', 'family', 'shared']
        && sharedOk(d)
        && d.viewerVisible is bool
        && (d.visibility == 'family' || d.viewerVisible == false)
        && d.ownerId is string
        && (!('log' in d) || d.log is map)
        && (!('weekdays' in d) || d.weekdays is list);
    }

    // Who can log a goal ("who can log"): the owner; every member for Family / Everyone; the people in
    // `editors` for Parents / Chosen people. Goals made before editAudience existed keep the old rule (anyone who
    // could write the doc).
    function canLogGoal(d) {
      return isMember() && (d.ownerId == request.auth.uid
        || d.get('editAudience', '') in ['family', 'everyone']
        || request.auth.uid in d.get('editors', [])
        || (!('editAudience' in d) && canWrite(d)));
    }

    match /goals/{goalId} {
      // People who can log a goal can also see it (the app keeps them inside "who can view" too).
      allow read: if canRead(resource.data) || (isMember() && request.auth.uid in resource.data.get('editors', []));
      allow create: if isMember()
        && request.resource.data.ownerId == request.auth.uid
        && validGoal(request.resource.data);
      // Only the owner changes the goal itself; everyone else who can log it changes only the log.
      allow update: if canLogGoal(resource.data)
        && validGoal(request.resource.data)
        && (resource.data.ownerId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['log', 'updatedAt']));
      allow delete: if isMember() && resource.data.ownerId == request.auth.uid;
    }

    // ---- Tasks ----

    // getAfter() so a batch that changes a list and its tasks together is checked against the new list.
    function validTask(d) {
      let list = getAfter(/databases/$(database)/documents/lists/$(d.listId)).data;
      return d.title is string && d.title.size() > 0
        && d.status in ['todo', 'doing', 'done', 'canceled']
        && d.priority in [1, 2, 3]
        && d.context in ['family', 'work']
        && d.durationDays is int && d.durationDays >= 1
        && d.dependsOn is list
        // Set only by the calendar sync (scripts/apps-script): { eventId, time?, location? }.
        && (!('calendar' in d) || d.calendar is map)
        // Day history: the day it was finished, and the days it was pushed off.
        && (!('finishedOn' in d) || (d.finishedOn is string && d.finishedOn.size() == 10))
        && (!('pushedFrom' in d) || d.pushedFrom is list)
        // Links lists: the address and an optional "Home/Utilities" category.
        && (!('url' in d) || (d.url is string && d.url.size() <= 2048))
        && (!('category' in d) || (d.category is string && d.category.size() <= 200))
        // Notes this entry refers to (ids), and a gift's quantity / color / size.
        && (!('noteIds' in d) || (d.noteIds is list && d.noteIds.size() <= 10))
        && (!('gift' in d) || d.gift is map)
        // A reading-list task: the link (in a links list) it's about.
        && (!('linkId' in d) || (d.linkId is string && d.linkId.size() <= 100))
        // Pick-list items: each person's stars (uid -> 1..5) and the days it was watched.
        && (!('ratings' in d) || d.ratings is map)
        && (!('watched' in d) || (d.watched is list && d.watched.size() <= 200))
        // Contacts: phones / emails / addresses / company / title / birthday.
        && (!('contact' in d) || d.contact is map)
        // Flashcards: each person's results (uid -> { known, right, wrong, last }).
        && (!('results' in d) || d.results is map)
        // Details, as on every entry: extra links and pictures (addresses).
        && (!('links' in d) || (d.links is list && d.links.size() <= 10))
        && (!('images' in d) || (d.images is list && d.images.size() <= 10))
        && d.visibility == list.visibility
        && d.get('sharedWith', null) == list.get('sharedWith', null)
        && d.ownerId == list.ownerId
        && d.viewerVisible == list.viewerVisible
        && d.get('editAudience', null) == list.get('editAudience', null)
        && d.get('editors', null) == list.get('editors', null);
    }

    // A view-only account may add ideas to a gift list it can see: always to a secret companion (it's on it), and to
    // the list itself unless the owner narrowed who edits (Only me, Parents, Chosen people).
    function viewerGiftList(listId) {
      let l = get(/databases/$(database)/documents/lists/$(listId)).data;
      return isViewer() && l.kind == 'gifts' && canRead(l)
        && (l.get('giftSecret', false) == true || !('editAudience' in l) || l.editAudience in ['family', 'everyone']);
    }

    match /tasks/{taskId} {
      allow read: if canRead(resource.data);
      // View-only accounts: their own gift ideas only (add, change, remove), nothing else.
      allow create: if isViewer() && request.resource.data.createdBy == request.auth.uid
        && viewerGiftList(request.resource.data.listId) && validTask(request.resource.data);
      allow update: if isViewer() && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && viewerGiftList(resource.data.listId) && viewerGiftList(request.resource.data.listId)
        && validTask(request.resource.data);
      allow delete: if isViewer() && resource.data.createdBy == request.auth.uid && viewerGiftList(resource.data.listId);
      allow create: if canWrite(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && validTask(request.resource.data);
      // The list's owner may also update tasks while changing the list's who-can-edit (the same batch).
      allow update: if canWrite(resource.data)
        && (canWrite(request.resource.data) || request.resource.data.ownerId == request.auth.uid)
        && request.resource.data.createdBy == resource.data.createdBy
        && validTask(request.resource.data);
      // Pick lists and flashcards: any member who can see an item may set their own stars, mark it watched, and
      // record their own flashcard results, even when only the list's owner edits it. Nothing else changes this
      // way, and only your own rating / results.
      allow update: if isMember() && canRead(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratings', 'watched', 'results', 'updatedAt'])
        && request.resource.data.get('ratings', {}).diff(resource.data.get('ratings', {})).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.get('results', {}).diff(resource.data.get('results', {})).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.get('results', {})) || request.resource.data.results[request.auth.uid] is map)
        && (!(request.auth.uid in request.resource.data.get('ratings', {}))
            || (request.resource.data.ratings[request.auth.uid] is int
                && request.resource.data.ratings[request.auth.uid] >= 1 && request.resource.data.ratings[request.auth.uid] <= 5))
        && (!('watched' in request.resource.data) || (request.resource.data.watched is list && request.resource.data.watched.size() <= 200));
      allow delete: if canWrite(resource.data);
    }

    // ---- Voting ----

    function boardVisible(boardId) {
      return isMember()
        || (isViewer() && get(/databases/$(database)/documents/boards/$(boardId)).data.viewerVisible == true);
    }

    function validComment(d) {
      return d.text is string && d.text.size() > 0 && d.text.size() <= 2000 && d.uid is string;
    }

    match /boards/{boardId} {
      allow read: if isMember() || (isViewer() && resource.data.viewerVisible == true);
      allow create, update: if isMember()
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.viewerVisible is bool;
      allow delete: if isMember();

      // Comments on a board, or on an item (below): members write their own; anyone who can see the board reads.
      match /comments/{commentId} {
        allow read: if boardVisible(boardId);
        allow create: if isMember() && validComment(request.resource.data) && request.resource.data.uid == request.auth.uid;
        allow update: if isMember() && resource.data.uid == request.auth.uid
          && validComment(request.resource.data) && request.resource.data.uid == resource.data.uid;
        allow delete: if isMember() && resource.data.uid == request.auth.uid;
      }

      match /items/{itemId} {
        allow read: if boardVisible(boardId);
        // Optional note, links and pictures (image addresses); url / imageUrl are the older single ones.
        allow create, update: if isMember()
          && request.resource.data.title is string && request.resource.data.title.size() > 0
          && request.resource.data.status in ['open', 'chosen', 'archived']
          && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 5000))
          && (!('url' in request.resource.data) || (request.resource.data.url is string && request.resource.data.url.size() <= 2048))
          && (!('imageUrl' in request.resource.data) || (request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 2048))
          && (!('links' in request.resource.data) || (request.resource.data.links is list && request.resource.data.links.size() <= 10))
          && (!('images' in request.resource.data) || (request.resource.data.images is list && request.resource.data.images.size() <= 10));
        allow delete: if isMember();

        match /comments/{commentId} {
          allow read: if boardVisible(boardId);
          allow create: if isMember() && validComment(request.resource.data) && request.resource.data.uid == request.auth.uid;
          allow update: if isMember() && resource.data.uid == request.auth.uid
            && validComment(request.resource.data) && request.resource.data.uid == resource.data.uid;
          allow delete: if isMember() && resource.data.uid == request.auth.uid;
        }

        match /votes/{voterId} {
          allow read: if boardVisible(boardId);
          allow create, update: if isMember()
            && voterId == request.auth.uid
            && request.resource.data.uid == voterId
            && request.resource.data.tokens is int
            && request.resource.data.tokens >= 0;
          allow delete: if isMember() && voterId == request.auth.uid;
        }
      }
    }

    // Comments on a task (checklist item, note, link) or a goal: whoever can see it reads them; members who can
    // see it write their own, and edit / delete only their own (same as voting comments).
    function taskVisible(taskId) {
      return canRead(get(/databases/$(database)/documents/tasks/$(taskId)).data);
    }
    function goalVisible(goalId) {
      let g = get(/databases/$(database)/documents/goals/$(goalId)).data;
      return canRead(g) || (isMember() && request.auth.uid in g.get('editors', []));
    }
    match /tasks/{taskId}/comments/{commentId} {
      allow read: if taskVisible(taskId);
      allow create: if isMember() && taskVisible(taskId) && validComment(request.resource.data) && request.resource.data.uid == request.auth.uid;
      allow update: if isMember() && taskVisible(taskId) && resource.data.uid == request.auth.uid
        && validComment(request.resource.data) && request.resource.data.uid == resource.data.uid;
      allow delete: if isMember() && resource.data.uid == request.auth.uid;
    }
    match /goals/{goalId}/comments/{commentId} {
      allow read: if goalVisible(goalId);
      allow create: if isMember() && goalVisible(goalId) && validComment(request.resource.data) && request.resource.data.uid == request.auth.uid;
      allow update: if isMember() && goalVisible(goalId) && resource.data.uid == request.auth.uid
        && validComment(request.resource.data) && request.resource.data.uid == resource.data.uid;
      allow delete: if isMember() && resource.data.uid == request.auth.uid;
    }

    // Household settings shared by everyone, e.g. config/integrations { rescueGroupsKey } for The Daily's adoptable
    // pet. Only household accounts can read it (never in the app's code or a public page); members can change it.
    match /config/{docId} {
      allow read: if isMember() || isViewer();
      allow write: if isMember() && docId in ['integrations'];
    }

    // Pictures stored in Align (resized JPEG data, under 1 MB): entries keep "align-image:<id>" in `images`.
    // Anyone in the household can open one by its id (ids are random and only appear on entries they can see),
    // but no one can list the collection, so a picture is only reachable through an entry. Never edited; the
    // person who added it can delete it. View-only accounts add them too (pictures on the gift ideas they suggest).
    match /images/{imageId} {
      allow get: if isMember() || isViewer();
      allow list: if false;
      allow create: if (isMember() || isViewer())
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['data', 'width', 'height', 'createdBy', 'createdAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 1000000
        && request.resource.data.data.matches('^data:image/(jpeg|png|webp);base64,.*')
        && request.resource.data.width is int && request.resource.data.height is int;
      allow update: if false;
      allow delete: if (isMember() || isViewer()) && resource.data.createdBy == request.auth.uid;
    }

    // Family map (scripts/location): locations/{uid} is one person's latest position and a day's trail. Members
    // see everyone's (viewers don't). The household's helper account (bot: true; the Apps Script relaying each
    // phone's OwnTracks reports) writes it, but never while the person has paused (off) and never to pause it; the
    // person can pause, resume (off: false keeps the old point) or delete theirs.
    function isBot() {
      return signedIn() && get(/databases/$(database)/documents/household/main).data.members.get(request.auth.uid, {}).get('bot', false) == true;
    }

    function validLocation(d) {
      return d.keys().hasOnly(['lat', 'lon', 'acc', 'batt', 'tst', 'trail', 'off', 'updatedAt'])
        && d.off is bool
        && (!('lat' in d) || (d.lat is number && d.lat >= -90 && d.lat <= 90))
        && (!('lon' in d) || (d.lon is number && d.lon >= -180 && d.lon <= 180))
        && (!('acc' in d) || d.acc is number)
        && (!('batt' in d) || d.batt is number)
        && (!('tst' in d) || d.tst is number)
        && (!('trail' in d) || (d.trail is list && d.trail.size() <= 100));
    }

    match /locations/{uid} {
      allow read: if isMember();
      allow create: if validLocation(request.resource.data) && roleOf(uid) == 'member'
        && ((isMember() && request.auth.uid == uid) || (isBot() && request.resource.data.off == false));
      allow update: if validLocation(request.resource.data)
        && ((isMember() && request.auth.uid == uid)
            || (isBot() && resource.data.off == false && request.resource.data.off == false));
      allow delete: if isMember() && request.auth.uid == uid;
    }

    // Gift claims: who is getting what. Any household account may claim, view-only ones too (extended family
    // coordinating gifts); claims are their own documents, so this gives viewers no other writes. Never readable by the person the gift is for (recipientId is their uid, or
    // "name:…" for someone outside the household), so the app queries them with recipientId == the list's
    // recipient. You add, change and remove only your own claim (id <item>_<you>), on an item of that list, with the
    // list's real recipient, and never on a gift meant for you.
    function giftRecipientOf(listId) {
      let l = get(/databases/$(database)/documents/lists/$(listId)).data;
      return l.get('recipientId', 'name:' + l.get('recipientName', ''));
    }

    function validClaim(claimId, d) {
      return d.keys().hasOnly(['listId', 'itemId', 'recipientId', 'claimedBy', 'title', 'qty', 'bought', 'note', 'updatedAt'])
        && d.claimedBy == request.auth.uid
        && claimId == d.itemId + '_' + request.auth.uid
        && d.recipientId != request.auth.uid
        && get(/databases/$(database)/documents/lists/$(d.listId)).data.kind == 'gifts'
        && d.recipientId == giftRecipientOf(d.listId)
        && d.title is string && d.title.size() <= 500
        && d.qty is int && d.qty >= 1 && d.qty <= 99
        && d.bought is bool
        && (!('note' in d) || (d.note is string && d.note.size() <= 500));
    }

    match /giftClaims/{claimId} {
      allow read: if (isMember() || isViewer()) && resource.data.recipientId != request.auth.uid;
      allow create: if (isMember() || isViewer()) && validClaim(claimId, request.resource.data)
        && get(/databases/$(database)/documents/tasks/$(request.resource.data.itemId)).data.listId == request.resource.data.listId;
      allow update: if (isMember() || isViewer()) && resource.data.claimedBy == request.auth.uid && validClaim(claimId, request.resource.data)
        && request.resource.data.itemId == resource.data.itemId && request.resource.data.listId == resource.data.listId;
      allow delete: if (isMember() || isViewer()) && resource.data.claimedBy == request.auth.uid;
    }

    // Members compute their token balance with a collection-group query over their own votes.
    match /{path=**}/votes/{voterId} {
      allow read: if isMember();
    }
  }
}
