rules_version = '2';

// See DESIGN.md §11. Household roles live in household/main and change only via the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Roles ----

    function signedIn() {
      return request.auth != null;
    }

    function roleOf(uid) {
      return get(/databases/$(database)/documents/household/main).data.members.get(uid, {}).get('role', '');
    }

    function isMember() {
      return signedIn() && roleOf(request.auth.uid) == 'member';
    }

    function isViewer() {
      return signedIn() && roleOf(request.auth.uid) == 'viewer';
    }

    // ---- Lists and tasks share visibility (tasks carry a copy of their list's fields) ----

    // Shared docs list their people in sharedWith (only shared docs have that field; see sharedOk), so
    // "shared with me" is the single query where('sharedWith', 'array-contains', uid), which this rule can prove.
    function canRead(d) {
      return (d.visibility == 'private' && isMember() && d.ownerId == request.auth.uid)
        || (d.visibility == 'family' && (isMember() || (isViewer() && d.viewerVisible == true)))
        || ((isMember() || isViewer()) && request.auth.uid in d.get('sharedWith', []));
    }

    // Visibility 'shared' if and only if there's a sharedWith list of 1-20 people that includes the owner.
    function sharedOk(d) {
      return (d.visibility == 'shared') == ('sharedWith' in d)
        && (!('sharedWith' in d) || (d.sharedWith is list && d.sharedWith.size() >= 1 && d.sharedWith.size() <= 20
                                     && d.ownerId in d.sharedWith));
    }

    function canWrite(d) {
      return isMember() && (d.visibility == 'family' || d.ownerId == request.auth.uid || request.auth.uid in d.get('sharedWith', []));
    }

    // ---- Household ----

    function ownMemberEntryOnly() {
      let before = resource.data.members;
      let after = request.resource.data.members;
      let uid = request.auth.uid;
      return after.diff(before).affectedKeys().hasOnly([uid])
        && after[uid].role == before[uid].role
        && after[uid].keys().hasOnly(['role', 'displayName', 'color', 'defaultVisibility', 'phone'])
        // Their own default for new lists and quick adds, and their mobile number for "text …" (Settings).
        && (!('defaultVisibility' in after[uid]) || after[uid].defaultVisibility in ['private', 'parents', 'family', 'everyone'])
        && (!('phone' in after[uid]) || (after[uid].phone is string && after[uid].phone.size() <= 24));
    }

    // Once someone is in the Parents group, only a parent can change who's in it (so a child can't opt in).
    // While it's empty, any member can set it up.
    function parentsChangeOk() {
      let before = resource.data.get('groups', {}).get('parents', []);
      let after = request.resource.data.get('groups', {}).get('parents', []);
      return after == before || before.size() == 0 || request.auth.uid in before;
    }

    function householdExists() {
      return exists(/databases/$(database)/documents/household/main);
    }

    // First-time setup: before household/main exists, a signed-in user may create it with themselves as a member.
    function validNewHousehold() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'members', 'pets', 'weeklyTokens', 'tokenStartDate'])
        && d.name is string && d.name.size() > 0
        && d.members[request.auth.uid].role == 'member'
        && d.pets is list
        && d.weeklyTokens is int && d.weeklyTokens >= 0
        && d.tokenStartDate is timestamp;
    }

    match /household/main {
      allow read: if isMember() || isViewer();
      // Lets the app tell "not set up yet" apart from "not in this household".
      allow get: if signedIn() && !householdExists();
      allow create: if signedIn() && validNewHousehold();
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pets', 'weeklyTokens', 'members', 'groups'])
        && ownMemberEntryOnly()
        // groups: { parents: [uid, ...] } for the "Parents" sharing shortcut. Only a convenience: who can read a
        // shared list is always its own sharedWith list, shown by name when you share.
        && (!('groups' in request.resource.data) || request.resource.data.groups is map)
        && parentsChangeOk();
    }

    // ---- Lists ----

    function validList(d) {
      return d.name is string && d.name.size() > 0
        && d.kind in ['list', 'project', 'checklist', 'notes', 'links']
        && d.visibility in ['private', 'family', 'shared']
        && sharedOk(d)
        && d.viewerVisible is bool
        && (d.visibility == 'family' || d.viewerVisible == false)
        && d.defaultContext in ['family', 'work']
        && d.ownerId is string;
    }

    match /lists/{listId} {
      allow read: if canRead(resource.data);
      allow create: if canWrite(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && validList(request.resource.data);
      // Only the current owner may hand a list to someone else.
      allow update: if canWrite(resource.data)
        && canWrite(request.resource.data)
        && (request.resource.data.ownerId == resource.data.ownerId || resource.data.ownerId == request.auth.uid)
        && validList(request.resource.data);
      allow delete: if canWrite(resource.data);
    }

    // ---- Goals (daily: check, tally, progressive, measure) ----
    // Same privacy as lists (private / family / shared). The day-by-day log lives on the goal doc.

    function validGoal(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.kind in ['check', 'tally', 'progressive', 'measure', 'total']
        && (!('editAudience' in d) || d.editAudience in ['private', 'parents', 'family', 'shared', 'everyone'])
        && (!('editors' in d) || (d.editors is list && d.editors.size() <= 20))
        && d.visibility in ['private', 'family', 'shared']
        && sharedOk(d)
        && d.viewerVisible is bool
        && (d.visibility == 'family' || d.viewerVisible == false)
        && d.ownerId is string
        && (!('log' in d) || d.log is map)
        && (!('weekdays' in d) || d.weekdays is list);
    }

    // Who can log a goal ("who can log"): the owner; every member for Family / Everyone; the people in
    // `editors` for Parents / Chosen people. Goals made before editAudience existed keep the old rule (anyone who
    // could write the doc).
    function canLogGoal(d) {
      return isMember() && (d.ownerId == request.auth.uid
        || d.get('editAudience', '') in ['family', 'everyone']
        || request.auth.uid in d.get('editors', [])
        || (!('editAudience' in d) && canWrite(d)));
    }

    match /goals/{goalId} {
      // People who can log a goal can also see it (the app keeps them inside "who can view" too).
      allow read: if canRead(resource.data) || (isMember() && request.auth.uid in resource.data.get('editors', []));
      allow create: if isMember()
        && request.resource.data.ownerId == request.auth.uid
        && validGoal(request.resource.data);
      // Only the owner changes the goal itself; everyone else who can log it changes only the log.
      allow update: if canLogGoal(resource.data)
        && validGoal(request.resource.data)
        && (resource.data.ownerId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['log', 'updatedAt']));
      allow delete: if isMember() && resource.data.ownerId == request.auth.uid;
    }

    // ---- Tasks ----

    // getAfter() so a batch that changes a list and its tasks together is checked against the new list.
    function validTask(d) {
      let list = getAfter(/databases/$(database)/documents/lists/$(d.listId)).data;
      return d.title is string && d.title.size() > 0
        && d.status in ['todo', 'doing', 'done', 'canceled']
        && d.priority in [1, 2, 3]
        && d.context in ['family', 'work']
        && d.durationDays is int && d.durationDays >= 1
        && d.dependsOn is list
        // Set only by the calendar sync (scripts/apps-script): { eventId, time?, location? }.
        && (!('calendar' in d) || d.calendar is map)
        // Day history: the day it was finished, and the days it was pushed off.
        && (!('finishedOn' in d) || (d.finishedOn is string && d.finishedOn.size() == 10))
        && (!('pushedFrom' in d) || d.pushedFrom is list)
        // Links lists: the address and an optional "Home/Utilities" category.
        && (!('url' in d) || (d.url is string && d.url.size() <= 2048))
        && (!('category' in d) || (d.category is string && d.category.size() <= 200))
        // A reading-list task: the link (in a links list) it's about.
        && (!('linkId' in d) || (d.linkId is string && d.linkId.size() <= 100))
        // Details, as on every entry: extra links and pictures (addresses).
        && (!('links' in d) || (d.links is list && d.links.size() <= 10))
        && (!('images' in d) || (d.images is list && d.images.size() <= 10))
        && d.visibility == list.visibility
        && d.get('sharedWith', null) == list.get('sharedWith', null)
        && d.ownerId == list.ownerId
        && d.viewerVisible == list.viewerVisible;
    }

    match /tasks/{taskId} {
      allow read: if canRead(resource.data);
      allow create: if canWrite(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && validTask(request.resource.data);
      allow update: if canWrite(resource.data)
        && canWrite(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && validTask(request.resource.data);
      allow delete: if canWrite(resource.data);
    }

    // ---- Voting ----

    function boardVisible(boardId) {
      return isMember()
        || (isViewer() && get(/databases/$(database)/documents/boards/$(boardId)).data.viewerVisible == true);
    }

    function validComment(d) {
      return d.text is string && d.text.size() > 0 && d.text.size() <= 2000 && d.uid is string;
    }

    match /boards/{boardId} {
      allow read: if isMember() || (isViewer() && resource.data.viewerVisible == true);
      allow create, update: if isMember()
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.viewerVisible is bool;
      allow delete: if isMember();

      // Comments on a board, or on an item (below): members write their own; anyone who can see the board reads.
      match /comments/{commentId} {
        allow read: if boardVisible(boardId);
        allow create: if isMember() && validComment(request.resource.data) && request.resource.data.uid == request.auth.uid;
        allow update: if isMember() && resource.data.uid == request.auth.uid
          && validComment(request.resource.data) && request.resource.data.uid == resource.data.uid;
        allow delete: if isMember() && resource.data.uid == request.auth.uid;
      }

      match /items/{itemId} {
        allow read: if boardVisible(boardId);
        // Optional note, links and pictures (image addresses); url / imageUrl are the older single ones.
        allow create, update: if isMember()
          && request.resource.data.title is string && request.resource.data.title.size() > 0
          && request.resource.data.status in ['open', 'chosen', 'archived']
          && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 5000))
          && (!('url' in request.resource.data) || (request.resource.data.url is string && request.resource.data.url.size() <= 2048))
          && (!('imageUrl' in request.resource.data) || (request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 2048))
          && (!('links' in request.resource.data) || (request.resource.data.links is list && request.resource.data.links.size() <= 10))
          && (!('images' in request.resource.data) || (request.resource.data.images is list && request.resource.data.images.size() <= 10));
        allow delete: if isMember();

        match /comments/{commentId} {
          allow read: if boardVisible(boardId);
          allow create: if isMember() && validComment(request.resource.data) && request.resource.data.uid == request.auth.uid;
          allow update: if isMember() && resource.data.uid == request.auth.uid
            && validComment(request.resource.data) && request.resource.data.uid == resource.data.uid;
          allow delete: if isMember() && resource.data.uid == request.auth.uid;
        }

        match /votes/{voterId} {
          allow read: if boardVisible(boardId);
          allow create, update: if isMember()
            && voterId == request.auth.uid
            && request.resource.data.uid == voterId
            && request.resource.data.tokens is int
            && request.resource.data.tokens >= 0;
          allow delete: if isMember() && voterId == request.auth.uid;
        }
      }
    }

    // Pictures stored in Align (resized JPEG data, under 1 MB): entries keep "align-image:<id>" in `images`.
    // Anyone in the household can open one by its id (ids are random and only appear on entries they can see),
    // but no one can list the collection, so a picture is only reachable through an entry. Never edited; the
    // person who added it can delete it.
    match /images/{imageId} {
      allow get: if isMember() || isViewer();
      allow list: if false;
      allow create: if isMember()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['data', 'width', 'height', 'createdBy', 'createdAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 1000000
        && request.resource.data.data.matches('^data:image/(jpeg|png|webp);base64,.*')
        && request.resource.data.width is int && request.resource.data.height is int;
      allow update: if false;
      allow delete: if isMember() && resource.data.createdBy == request.auth.uid;
    }

    // Members compute their token balance with a collection-group query over their own votes.
    match /{path=**}/votes/{voterId} {
      allow read: if isMember();
    }
  }
}
