# Copy to .env.production.local and fill in from Firebase console → Project settings → Your apps.
VITE_USE_EMULATORS=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional: the Apps Script web app URL (scripts/apps-script/README.md) for the "Refresh calendar" button.
VITE_CALENDAR_SYNC_URL=

# Family map alerts (scripts/location/README.md): Firebase console → Project settings → General (messagingSenderId)
# and → Cloud Messaging → Web Push certificates (key pair). Both are public.
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
