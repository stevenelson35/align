{
  "name": "align",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run src tests/apps-script tests/samples",
    "emulators": "firebase emulators:start --project demo-align",
    "seed": "node scripts/seed-emulator.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-align \"vitest run tests/rules\"",
    "test:calendar": "node tests/apps-script/emulator-run.mjs",
    "deploy:rules": "firebase deploy --project prod --only firestore:rules,firestore:indexes",
    "deploy:web": "npm run build && scripts/deploy-turbify.sh"
  },
  "dependencies": {
    "@fontsource-variable/datatype": "^5.3.0",
    "chess.js": "^1.4.0",
    "chrono-node": "^2.10.2",
    "firebase": "^12.19.0",
    "heic-to": "^1.6.6",
    "js-yaml": "^5.5.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-admin": "^14.5.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
